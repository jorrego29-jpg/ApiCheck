# SITE_ADDRESS es el dominio (Caddy saca el certificado HTTPS solo) o ":80" para HTTP sin dominio.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# APICheck ejecuta peticiones a cualquier URL que se le pida: sin esta contraseña, cualquiera
	# en internet podría usar el servidor para llegar a la base de datos o a la red interna.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# El cliente llama a /api/...; el backend no tiene prefijo, así que se quita.
	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}
}
