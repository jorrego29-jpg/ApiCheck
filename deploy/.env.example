# Copia este archivo como `.env` en el VPS (DEPLOY_PATH, por defecto /opt/apicheck) y rellénalo.
# No lo subas a git.

# Dueño de las imágenes en GHCR, en minúsculas (usuario u organización de GitHub).
GHCR_OWNER=jorrego29-jpg

# Base de datos. Usa solo letras y números en la contraseña: va dentro de una URL.
POSTGRES_USER=apicheck
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=apicheck

# Dominio público (HTTPS automático) o :80 para HTTP sin dominio.
SITE_ADDRESS=apicheck.tudominio.com

# Solo si se llama a la API desde otro origen; con Caddy no hace falta.
CORS_ORIGIN=

# Acceso a la app. El hash se genera con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'tu-contraseña'
# Va entre comillas simples porque el hash lleva signos $.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$...'
